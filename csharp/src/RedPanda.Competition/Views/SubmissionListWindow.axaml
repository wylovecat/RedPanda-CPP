<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:RedPanda.Competition.Models"
        x:Class="RedPanda.Competition.Views.SubmissionListWindow"
        Title="全部提交"
        Width="760"
        Height="520"
        MinWidth="640"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppWindowBrush}"
        Icon="/AppAssets/redpanda.ico">

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
      <TextBlock x:Name="HeaderText" FontWeight="SemiBold" />
      <TextBlock x:Name="SummaryText" Classes="hint" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8"
                Margin="0,10,0,0">
      <Button x:Name="DetailButton"
              Content="查看详情"
              Classes="accent"
              IsEnabled="False"
              Click="Detail_Click"
              MinWidth="96" />
      <Button Content="关闭" Click="Close_Click" MinWidth="80" />
    </StackPanel>

    <ListBox x:Name="SubmissionList"
             Background="{DynamicResource PanelAltBrush}"
             BorderBrush="{DynamicResource BorderBrush}"
             BorderThickness="1"
             SelectionChanged="SubmissionList_SelectionChanged"
             DoubleTapped="SubmissionList_DoubleTapped">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="models:AscSubmissionRecord">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <TextBlock Text="{Binding Time}"
                       FontSize="11"
                       Foreground="{DynamicResource MutedTextBrush}"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Spacing="1">
              <TextBlock Text="{Binding Nickname}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding PerformanceText}"
                         FontSize="11"
                         Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
              <TextBlock Text="{Binding VerdictText}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding ScoreText}"
                         FontSize="11"
                         Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
