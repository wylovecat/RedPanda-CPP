<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RedPanda.Competition.Views.ContestWindow"
        Title="课堂计时"
        Width="480"
        Height="420"
        MinWidth="440"
        MinHeight="380"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppWindowBrush}"
        Icon="/AppAssets/redpanda.ico">

  <StackPanel Margin="22" Spacing="14">

    <TextBlock x:Name="HeaderText"
               Text="课堂计时"
               FontSize="17"
               FontWeight="SemiBold" />

    <TextBlock x:Name="RemainingText"
               Text="准备开始"
               FontSize="34"
               FontWeight="Bold"
               HorizontalAlignment="Center"
               Margin="0,6" />

    <TextBlock x:Name="HintText"
               Classes="hint"
               TextWrapping="Wrap" />

    <Grid x:Name="SetupPanel"
          ColumnDefinitions="110,*"
          RowDefinitions="Auto,Auto,Auto"
          RowSpacing="10"
          Margin="0,4">
      <TextBlock Text="标题" VerticalAlignment="Center" />
      <TextBox Grid.Column="1" x:Name="TitleBox" PlaceholderText="课堂测试" />

      <TextBlock Grid.Row="1" Text="时长（分钟）" VerticalAlignment="Center" />
      <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <NumericUpDown x:Name="MinutesBox"
                       Minimum="1"
                       Maximum="600"
                       Increment="5"
                       FormatString="0"
                       Width="130" />
        <TextBlock Text="结束后锁定在线交题" VerticalAlignment="Center" Classes="hint" />
      </StackPanel>

      <CheckBox Grid.Row="2"
                Grid.Column="1"
                x:Name="LockCheckBox"
                Content="时间到后禁止交题（仍可本地运行）" />
    </Grid>

    <StackPanel x:Name="RunningPanel"
                Orientation="Horizontal"
                Spacing="8"
                IsVisible="False">
      <Button Content="延长 5 分钟" Click="Extend_Click" />
      <Button Content="暂停" Click="Pause_Click" />
      <Button Content="交卷" Click="Finish_Click" Classes="accent" />
      <Button Content="查看汇总" Click="Summary_Click" />
    </StackPanel>

    <StackPanel x:Name="PausedPanel"
                Orientation="Horizontal"
                Spacing="8"
                IsVisible="False">
      <Button Content="继续" Click="Resume_Click" Classes="accent" />
      <Button Content="交卷" Click="Finish_Click" />
      <Button Content="查看汇总" Click="Summary_Click" />
      <Button Content="导出汇总" Click="Export_Click" />
    </StackPanel>

    <StackPanel x:Name="FinishedPanel"
                Orientation="Horizontal"
                Spacing="8"
                IsVisible="False">
      <Button Content="查看汇总" Click="Summary_Click" Classes="accent" />
      <Button Content="导出汇总" Click="Export_Click" />
      <Button Content="重新开始" Click="Restart_Click" />
      <Button Content="清除计时" Click="Clear_Click" />
    </StackPanel>

    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8"
                Margin="0,8,0,0">
      <Button x:Name="StartButton" Content="开始" Click="Start_Click" Classes="accent" MinWidth="86" />
      <Button Content="关闭" Click="Close_Click" MinWidth="86" />
    </StackPanel>

  </StackPanel>
</Window>
