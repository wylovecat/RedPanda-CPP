<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RedPanda.Competition.Views.StressWindow"
        Title="随机对拍"
        Width="820"
        Height="600"
        MinWidth="700"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppWindowBrush}"
        Icon="/AppAssets/redpanda.ico">

  <DockPanel Margin="16">

    <Grid DockPanel.Dock="Top"
          ColumnDefinitions="90,*,Auto"
          RowDefinitions="Auto,Auto,Auto,Auto"
          RowSpacing="8"
          ColumnSpacing="8"
          Margin="0,0,0,10">

      <TextBlock Text="当前程序" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" x:Name="SolutionPathText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <TextBlock Grid.Column="2" Classes="hint" Text="使用编辑器中已保存的版本" VerticalAlignment="Center" />

      <TextBlock Grid.Row="1" Text="数据生成器" VerticalAlignment="Center" />
      <TextBox Grid.Row="1" Grid.Column="1" x:Name="GeneratorBox" PlaceholderText="选择生成随机输入的 .cpp" />
      <Button Grid.Row="1" Grid.Column="2" Content="选择…" Click="BrowseGenerator_Click" />

      <TextBlock Grid.Row="2" Text="暴力程序" VerticalAlignment="Center" />
      <TextBox Grid.Row="2" Grid.Column="1" x:Name="BruteBox" PlaceholderText="选择保证正确但较慢的 .cpp" />
      <Button Grid.Row="2" Grid.Column="2" Content="选择…" Click="BrowseBrute_Click" />

      <TextBlock Grid.Row="3" Text="轮数" VerticalAlignment="Center" />
      <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <NumericUpDown x:Name="RoundsBox" Minimum="1" Maximum="10000" Increment="10" Value="200" Width="130" />
        <Button x:Name="StartButton" Content="开始对拍" Classes="accent" Click="Start_Click" />
        <Button x:Name="StopButton" Content="停止" Click="Stop_Click" IsEnabled="False" />
      </StackPanel>
    </Grid>

    <StackPanel DockPanel.Dock="Bottom"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8"
                Margin="0,10,0,0">
      <TextBlock x:Name="StatusText"
                 Classes="hint"
                 VerticalAlignment="Center"
                 Margin="0,0,12,0" />
      <Button Content="关闭" Click="Close_Click" MinWidth="80" />
    </StackPanel>

    <TextBox x:Name="LogBox"
             IsReadOnly="True"
             AcceptsReturn="True"
             TextWrapping="NoWrap"
             FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
             FontSize="12"
             Background="{DynamicResource PanelAltBrush}"
             ScrollViewer.HorizontalScrollBarVisibility="Auto"
             ScrollViewer.VerticalScrollBarVisibility="Auto" />
  </DockPanel>
</Window>
