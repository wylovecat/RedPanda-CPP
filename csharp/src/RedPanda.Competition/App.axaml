<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RedPanda.Competition.App"
             RequestedThemeVariant="Light">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppWindowBrush" Color="#F3F4F6" />
          <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="PanelAltBrush" Color="#F8F9FB" />
          <SolidColorBrush x:Key="BorderBrush" Color="#DCE0E5" />
          <SolidColorBrush x:Key="MutedTextBrush" Color="#667085" />
          <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="EditorForegroundBrush" Color="#1F2328" />
          <SolidColorBrush x:Key="EditorLineNumberBrush" Color="#98A2B3" />
          <SolidColorBrush x:Key="HoverBrush" Color="#EEF1F5" />
          <SolidColorBrush x:Key="SuccessBrush" Color="#15803D" />
          <SolidColorBrush x:Key="ErrorBrush" Color="#D92D20" />
          <SolidColorBrush x:Key="WarnBrush" Color="#B54708" />
          <SolidColorBrush x:Key="RunAccentBrush" Color="#0F6CBD" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppWindowBrush" Color="#1B1C1F" />
          <SolidColorBrush x:Key="PanelBrush" Color="#24262A" />
          <SolidColorBrush x:Key="PanelAltBrush" Color="#2B2D32" />
          <SolidColorBrush x:Key="BorderBrush" Color="#3A3D43" />
          <SolidColorBrush x:Key="MutedTextBrush" Color="#9AA3AE" />
          <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#1E1F22" />
          <SolidColorBrush x:Key="EditorForegroundBrush" Color="#D6DAE0" />
          <SolidColorBrush x:Key="EditorLineNumberBrush" Color="#6F7884" />
          <SolidColorBrush x:Key="HoverBrush" Color="#31343A" />
          <SolidColorBrush x:Key="SuccessBrush" Color="#4ADE80" />
          <SolidColorBrush x:Key="ErrorBrush" Color="#F87171" />
          <SolidColorBrush x:Key="WarnBrush" Color="#FBBF24" />
          <SolidColorBrush x:Key="RunAccentBrush" Color="#3B82F6" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI, sans-serif" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="Button.toolbar">
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Button.toolbar:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    </Style>

    <Style Selector="Button.run">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="14,5" />
      <Setter Property="MinHeight" Value="30" />
    </Style>

    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>

    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,6,0,4" />
    </Style>

    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="ToolTip">
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinHeight" Value="34" />
    </Style>
  </Application.Styles>
</Application>
